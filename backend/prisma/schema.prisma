generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  passwordHash  String
  role          Role
  status        AccountStatus @default(PENDING)
  emailVerifiedAt            DateTime?
  emailVerificationTokenHash String?
  emailVerificationExpiresAt DateTime?
  emailChangeTokenHash String?
  emailChangeExpiresAt DateTime?
  pendingEmail               String?
  statusReason String?
  suspendedAt  DateTime?
  passwordResetTokenHash     String?
  passwordResetTokenExpiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // RELATIONS
  clientProfile     ClientProfile?
  restaurantProfile RestaurantProfile?
  livreurProfile    LivreurProfile?

  clientOrders      Order[] @relation("ClientOrders")
  restaurantOrders  Order[] @relation("RestaurantOrders")
  livreurOrders     Order[] @relation("LivreurOrders")

  offers            Offer[] @relation("RestaurantOffers")

  reviewsGiven      Review[] @relation("Reviewer")
  restaurantReviews Review[] @relation("RestaurantReview")
  delivererReviews  Review[] @relation("DelivererReview")

  complaintsGiven       Complaint[] @relation("Complainant")
  restaurantComplaints  Complaint[] @relation("RestaurantComplaint")
  delivererComplaints   Complaint[] @relation("DelivererComplaint")

  accountHistory AccountHistory[]
  legalAgreements LegalAgreement[]

  clientInteractions ClientInteraction[]

  appNotifications AppNotification[]
  deviceTokens UserDeviceToken[]

  @@index([role])
  @@index([status])
}
model ClientProfile {
  id          String @id @default(cuid())
  userId      String @unique
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  clientType     ClientType @default(NORMAL)

  fullName       String?
  phone          String?
  defaultAddress String?

  societyName    String?
  fiscalNumber   String?
  proPhone       String?
  proAddress     String?

  cuisinePreferences CuisinePreference[]
  notificationPreferences Json @default("{}")

  locationConsentGiven Boolean @default(false)
  locationConsentGivenAt DateTime?

  lastLatitude  Float?
  lastLongitude Float?
  lastLocationAt DateTime?

  submittedAt DateTime?
  joinedAt DateTime?
  termsAcceptedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}                    
model RestaurantProfile {
  id       String @id @default(cuid())
  userId   String @unique
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  restaurantName    String?
  establishmentType EstablishmentType?
  phone             String?
  address           String?
  city              String?

  latitude  Float?
  longitude Float?

  logoUrl      String?
  coverImageUrl String?

  legalEntityName String?
  registrationNumberRNE String?
  ownershipType OwnershipType?

  businessRegistrationDocumentUrl String?
  hygieneCertificateUrl String?
  proofOfOwnershipOrLeaseUrl String?

  payoutMethod PayoutMethod?
  payoutDetails Json?

  avgRating      Float @default(0)
  commissionRate Float @default(15)

  submittedAt DateTime?
  legalCompletedAt DateTime?
  identityCompletedAt DateTime?
  payoutCompletedAt DateTime?
  termsAcceptedAt DateTime?
  termsAcceptedName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LegalAgreement {
  id         String   @id @default(cuid())
  userId     String
  type       String
  content    String
  acceptedAt DateTime @default(now())
  signerName String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AccountHistory {
  id        String        @id @default(cuid())
  userId    String
  actorId   String
  actorRole String
  action    AccountAction
  field     String?
  oldValue  String?
  newValue  String?
  reason    String?
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LivreurProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName   String?
  phone      String?
  vehicleType String?
  zone        String?

  photoUrl String?

  cinOrPassportNumber String?
  cinFrontPhotoUrl String?
  cinBackPhotoUrl String?
  cinVerificationStatus String?
  identityVerified Boolean @default(false)
  identityVerifiedAt DateTime?
  cinVerifiedAt DateTime?

  licensePhotoUrl String?
  vehiclePhotoUrl  String?
  vehicleOwnershipDocUrl String?

  termsAcceptedAt DateTime?
  termsAcceptedName String?
  submittedAt DateTime?

  payoutMethod PayoutMethod?
  payoutDetails Json?

  avgRating Float @default(0)

  cinBackPhotoUrl        String?
  cinFrontPhotoUrl       String?
  cinVerificationStatus  String?       @default("PENDING")
  cinVerifiedAt          DateTime?
  identityVerified       Boolean       @default(false)
  identityVerifiedAt     DateTime?

  locationConsentGiven Boolean @default(false)
  locationConsentGivenAt DateTime?
  lastLatitude  Float?
  lastLongitude Float?
  lastLocationAt DateTime?

  isOnline Boolean @default(false)
  lastOnlineAt DateTime?

  notificationPreferences Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model Order {
  id        String @id @default(uuid())

  orderCode String
  reference String @unique

  offerId String
  offer   Offer @relation(fields: [offerId], references: [id])

  clientId String
  client   User @relation("ClientOrders", fields: [clientId], references: [id])

  restaurantId String
  restaurant   User @relation("RestaurantOrders", fields: [restaurantId], references: [id])

  livreurId String?
  livreur   User? @relation("LivreurOrders", fields: [livreurId], references: [id])

  items Json
  total Float

  status OrderStatus @default(PENDING)

  collectionMethod CollectionMethod?
  deliveryAddress  String?
  deliveryPhone    String?
  deliveryFee      Float?

  paymentMethod PaymentMethod?
  paymentDetails Json?

  clientLocation    String?
  delivererLocation String?

  // QR SYSTEM (pickup safety)
  pickupQrTokenHash String?
  pickupQrExpiresAt DateTime?
  pickupQrUsedAt    DateTime?
  pickupQrStatus    QrStatus @default(NOT_SCANNED)

  pickupReminderSentAt DateTime?
  delivererPickupReminderSentAt DateTime?
  delivererPickupTimeReminderSentAt DateTime?
  deliveryConfirmReminderSentAt DateTime?
  reviewReminderSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviews    Review[]
  complaints Complaint[]
}

model Offer {
  id             String @id @default(cuid())
  restaurantId   String
  restaurant     User   @relation("RestaurantOffers", fields: [restaurantId], references: [id], onDelete: Restrict)

  description    String
  originalPrice  Float
  discountedPrice Float
  quantity       Int

  photoUrl String
  descriptionEmbedding Float[]

  pickupTime     String
  pickupDateTime DateTime

  categories String[] @default([])

  visibility OfferVisibility @default(IDENTIFIED)
  deliveryAvailable Boolean @default(false)

  status OfferStatus @default(ACTIVE)

  orders Order[]
  clientInteractions ClientInteraction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId])
  @@index([status])
}

model Review {
  id String @id @default(cuid())

  orderId String?
  order   Order? @relation(fields: [orderId], references: [id])

  reviewerId String
  reviewer   User @relation("Reviewer", fields: [reviewerId], references: [id])

  restaurantId String?
  restaurant   User? @relation("RestaurantReview", fields: [restaurantId], references: [id])

  delivererId String?
  deliverer   User? @relation("DelivererReview", fields: [delivererId], references: [id])

  rating Int
  comment String

  createdAt DateTime @default(now())
}

model Complaint {
  id String @id @default(cuid())

  orderId String?
  order   Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  complainantId String
  complainant   User @relation("Complainant", fields: [complainantId], references: [id], onDelete: Cascade)

  restaurantId String?
  restaurant   User? @relation("RestaurantComplaint", fields: [restaurantId], references: [id])

  delivererId String?
  deliverer   User? @relation("DelivererComplaint", fields: [delivererId], references: [id])

  reason String
  description String?

  createdAt DateTime @default(now())
}

model AppNotification {
  id String @id @default(cuid())

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  type NotificationType
  title String
  message String
  body String?
  orderId String?
  payload Json?
  data Json?

  isRead Boolean @default(false)
  readAt DateTime?

  createdAt DateTime @default(now())
}

model UserDeviceToken {
  id String @id @default(cuid())

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  token String @unique
  platform String

  active Boolean @default(true)
  revokedAt DateTime?
  lastSeenAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum NotificationType {
  ORDER_STATUS
  ORDER_STATUS_UPDATED
  ORDER_READY_FOR_DELIVERER
  DELIVERY_STATUS
  DELIVERY_CONFIRMATION_REMINDER
  NEW_DELIVERY_AVAILABLE
  PICKUP_REMINDER
  REVIEW_RESTAURANT_REMINDER
  REVIEW_DELIVERER_REMINDER
  DELIVERER_PICKUP_TIME_REMINDER
  PROMOTION
  SYSTEM
  CHAT
}

model ClientInteraction {
  id String @id @default(cuid())

  userId String?
  clientId String?
  user   User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  offerId String?
  offer   Offer? @relation(fields: [offerId], references: [id], onDelete: SetNull)
  restaurantId String?

  type String?
  interactionType String?
  value Float?
  price Float?
  categories String[]

  createdAt DateTime @default(now())
}

enum Category {
  BAKERY
  GRILL
  FAST_FOOD
  VEGETARIAN
  HALAL
  SEAFOOD
  SUSHI
  PIZZA
  BURGER
  BBQ
  HEALTHY
  DESSERT
  STREET_FOOD
  SANDWICHES
  SALAD
  PASTA
  BREAKFAST
  FINE_DINING
  BRUNCH
}

enum Role {
  CLIENT
  LIVREUR
  RESTAURANT
  ADMIN
}

enum AccountStatus {
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUIRED
  SUSPENDED
  UNSUSPEND
  PROFILE_EDIT
}

enum OrderStatus {
  PENDING
  CONFIRMED
  ASSIGNED
  READY
  PICKED_UP
  DELIVERED
  CANCELLED
  EXPIRED
}

enum PaymentMethod {
  CARD
  D17
  PAYPAL
}

enum CollectionMethod {
  PICKUP
  DELIVERY
}

enum QrStatus {
  NOT_SCANNED
  SCANNED
  USED
  EXPIRED
}

enum OfferStatus {
  ACTIVE
  INACTIVE
  PAUSED
  SOLD_OUT
  EXPIRED
  DELETED
}

enum OfferVisibility {
  IDENTIFIED
  ANONYMOUS
}

enum PayoutMethod {
  BANK_TRANSFER
  PAYPAL
}

enum AccountAction {
  CREATED
  UPDATED
  DELETED
  SUSPENDED
  UNSUSPENDED
  UNSUSPEND
  SUSPEND
  APPROVED
  APPROVE
  REJECTED
  REJECT
  EMAIL_CHANGED
  PASSWORD_CHANGED
  PROFILE_EDIT
  PROFILE_EDITED
  REQUIRE_CHANGES
}

enum CuisinePreference {
  BAKERY
  GRILL
  FAST_FOOD
  VEGETARIAN
  HALAL
  SEAFOOD
  SUSHI
  PIZZA
  BURGER
  BBQ
  HEALTHY
  DESSERT
  STREET_FOOD
  SANDWICHES
  SALAD
  PASTA
  BREAKFAST
  FINE_DINING
  BRUNCH
}

enum EstablishmentType {
  RESTAURANT
  CAFE
  BAKERY
  FAST_FOOD
  FOOD_TRUCK
  CATERING
}

enum OwnershipType {
  INDIVIDUAL
  COMPANY
  PARTNERSHIP
}

enum ClientType {
  NORMAL
  PRO
}